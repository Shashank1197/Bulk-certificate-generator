# Application Settings
PROJECT_NAME="Bulk Certificate Generator API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Base URL used for constructing public download and QR code verification links
BASE_URL="http://localhost:8000"

# Database Configuration (SQLite default, can be pointed to PostgreSQL / MySQL)
# SQLite: sqlite:///./certificates.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/certificate_db
DATABASE_URL="sqlite:///./certificates.db"

# Storage Settings
STORAGE_DIR="storage/certificates"

# Bulk Job Parameters
MAX_RECIPIENTS_PER_JOB=5000
